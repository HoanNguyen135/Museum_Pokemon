{
  "name": "RN_Base",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package",
    "checkpackage": "npx react-native config | findstr /i lottie",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write src && prettier --check src",
    "build_code_push_package": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output ./build/index.android.bundle --assets-dest ./build",
    "zip_code_push": "Compress-Archive -Path ./build/* -DestinationPath update.zip -Force"
  },
  "dependencies": {
    "@apollo/client": "^4.2.6",
    "@apollo/react-hooks": "^4.0.0",
    "@code-push-next/react-native-code-push": "^10.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-vector-icons/material-icons": "^13.1.1",
    "@react-native/new-app-screen": "0.85.3",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/drawer": "^7.10.2",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react-native": "^8.12.0",
    "@shopify/flash-list": "^2.3.1",
    "axios": "^1.16.1",
    "graphql": "^17.0.2",
    "i18n-js": "^3.8.0",
    "lottie-react-native": "^7.3.8",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-config": "^1.6.1",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-keyboard-controller": "^1.21.8",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-snackbar": "^3.0.1",
